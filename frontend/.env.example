# URL do backend FastAPI. Padrão: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Credenciais do Firebase Web SDK (Console do Firebase > Configurações do
# projeto > Seus apps > SDK setup and configuration). Necessárias para o
# ranking (Firestore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
